[
  {
    "id": "R001",
    "name": "High CPU usage",
    "description": "Detects high CPU usage processes",
    "severity": "high",
    "target_os": ["windows", "linux", "darwin"],
    "logic": "AND",
    "conditions": [
      {
        "field": "cpu_percent",
        "operator": ">",
        "value": 80
      }
    ],
    "exceptions": [],
    "actions": ["generate_alert"]
  },
  {
    "id": "R002",
    "name": "Dangerous Command Execution",
    "description": "Detects execution of dangerous 'rm -rf' command",
    "severity": "critical",
    "target_os": ["linux", "darwin"],
    "logic": "OR",
    "conditions": [
      {
        "field": "cmd",
        "operator": "contains",
        "value": "rm -rf"
      }
    ],
    "exceptions": [
      {
        "field": "username",
        "value": "trusted_admin"
      }
    ],
    "actions": ["generate_alert", "flag_for_review"]
  }
]
