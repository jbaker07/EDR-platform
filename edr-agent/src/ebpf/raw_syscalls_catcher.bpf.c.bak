[2][1]int   msg_namelen;
[2][1]} msgh = {};
[2][1]bpf_probe_read_user(&msgh, sizeof(msgh), (void*)ctx->args[1]);
[2][1]if (msgh.msg_name && msgh.msg_namelen > 0) {
[2][1]struct sockaddr sa = {};
[2][1]bpf_probe_read_user(&sa, sizeof(sa), msgh.msg_name);
[2][1]e->fam = sa.sa_family;
[2][1]if (sa.sa_family == AF_INET) {
[2][1]struct sockaddr_in sin = {};
[2][1]bpf_probe_read_user(&sin, sizeof(sin), msgh.msg_name);
[2][1]e->raddr4 = sin.sin_addr.s_addr; e->rport = sin.sin_port;
[2][1]} else if (sa.sa_family == AF_INET6) {
[2][1]struct sockaddr_in6 sin6 = {};
[2][1]bpf_probe_read_user(&sin6, sizeof(sin6), msgh.msg_name);
[2][1]__builtin_memcpy(e->raddr6, &sin6.sin6_addr, 16); e->rport = sin6.sin6_port;
[2][1]}
[2][1]}
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]break;
[2][1]}
[2][1]case __NR_recvfrom: {
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (!e) break;
[2][1]ev_fill_common(e, EVT_RECVFROM, id, tgid);
[2][1]e->fd = (__s32)ctx->args[0];
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]break;
[2][1]}
[2][1]case __NR_recvmsg: {
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (!e) break;
[2][1]ev_fill_common(e, EVT_RECVMSG, id, tgid);
[2][1]e->fd = (__s32)ctx->args[0];
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]break;
[2][1]}
[2][1]
[2][1]/* ---- NAMESPACE / MOUNT / MODULE / BPF ---- */
[2][1]#if defined(__NR_setns)
[2][1]case __NR_setns: {
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (!e) break;
[2][1]ev_fill_common(e, EVT_SETNS, id, tgid);
[2][1]e->fd = -1;
