[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (!e) break;
[2][1]ev_fill_common(e, EVT_MOD_DEL, id, tgid);
[2][1]e->fd = -1;
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]break;
[2][1]}
[2][1]#endif
[2][1]
[2][1]/* ---- PRIVILEGE ---- */
[2][1]#if defined(__NR_setuid)
[2][1]case __NR_setuid: {
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (!e) break;
[2][1]ev_fill_common(e, EVT_SETUID, id, tgid);
[2][1]e->fd = -1;
[2][1]e->aux_u32 = (__u32)ctx->args[0]; // new uid
[2][1]bpf_ringbuf_submit(e, 0);
