[2][1]#endif
[2][1]#if defined(__NR_finit_module)
[2][1]case __NR_finit_module:
[2][1]#endif
[2][1]{
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (!e) break;
[2][1]ev_fill_common(e, EVT_MOD_LOAD, id, tgid);
