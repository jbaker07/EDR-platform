[2][1]e->fd = -1;
[2][1]e->flags = (__u32)ctx->args[0];
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]break;
[2][1]}
[2][1]#endif
[2][1]case __NR_mount: {
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (!e) break;
[2][1]ev_fill_common(e, EVT_MOUNT, id, tgid);
[2][1]e->fd = -1;
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]break;
[2][1]}
[2][1]case __NR_umount2: {
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (!e) break;
[2][1]ev_fill_common(e, EVT_UMOUNT2, id, tgid);
