[2][1]}
[2][1]
[2][1]return 0;
[2][1]}
[2][1]
[2][1]/* -------- sys_exit -------- */
[2][1]SEC("tracepoint/raw_syscalls/sys_exit")
[2][1]int tp_sys_exit(struct trace_event_raw_sys_exit *ctx)
[2][1]{
[2][1]__u32 id = (__u32)ctx->id;
[2][1]if (!edr_allowed(id)) return 0;
[2][1]
[2][1]__u64 pid_tgid = bpf_get_current_pid_tgid();
[2][1]__u32 tgid = (__u32)(pid_tgid >> 32);
[2][1]__s64 ret = ctx->ret;
[2][1]
[2][1]switch (id) {
[2][1]/* open family → fd table */
[2][1]case __NR_openat:
[2][1]#if defined(__NR_openat2)
[2][1]case __NR_openat2:
[2][1]#endif
[2][1]{
[2][1]struct pending_open *po = bpf_map_lookup_elem(&edr_pending_open, &pid_tgid);
[2][1]if (!po) break;
[2][1]
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (e) {
[2][1]ev_fill_common(e, EVT_OPEN, id, tgid);
[2][1]e->ret = ret; e->fd = (ret >= 0) ? (__s32)ret : -1;
[2][1]e->flags = po->flags;
[2][1]__builtin_memcpy(e->path, po->path, sizeof(e->path));
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]}
[2][1]
[2][1]if (ret >= 0) {
[2][1]struct fd_key fk = { .tgid = tgid, .fd = (__s32)ret };
[2][1]struct fd_meta fm = {};
[2][1]fm.kind = 1; // file
[2][1]__builtin_memcpy(fm.path, po->path, sizeof(fm.path));
[2][1]bpf_map_update_elem(&edr_fd_table, &fk, &fm, BPF_ANY);
[2][1]}
[2][1]bpf_map_delete_elem(&edr_pending_open, &pid_tgid);
[2][1]break;
[2][1]}
[2][1]
[2][1]/* socket → fd table */
[2][1]case __NR_socket: {
[2][1]struct pending_socket *ps = bpf_map_lookup_elem(&edr_pending_socket, &pid_tgid);
[2][1]if (!ps) break;
[2][1]
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (e) {
[2][1]ev_fill_common(e, EVT_SOCKET, id, tgid);
[2][1]e->ret = ret; e->fd = (ret >= 0) ? (__s32)ret : -1;
[2][1]e->fam = (ps->domain >= 0 && ps->domain <= 255) ? (__u8)ps->domain : 0;
[2][1]e->proto = (ps->proto  >= 0 && ps->proto  <= 255) ? (__u8)ps->proto  : 0;
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]}
[2][1]
[2][1]if (ret >= 0) {
[2][1]struct fd_key fk = { .tgid = tgid, .fd = (__s32)ret };
[2][1]struct fd_meta fm = {};
[2][1]fm.kind   = 2; // socket
[2][1]fm.family = (ps->domain >= 0 && ps->domain <= 255) ? (__u8)ps->domain : 0;
[2][1]fm.proto  = (ps->proto  >= 0 && ps->proto  <= 255) ? (__u8)ps->proto  : 0;
[2][1]bpf_map_update_elem(&edr_fd_table, &fk, &fm, BPF_ANY);
[2][1]}
[2][1]bpf_map_delete_elem(&edr_pending_socket, &pid_tgid);
[2][1]break;
[2][1]}
[2][1]
[2][1]#if defined(__NR_memfd_create)
[2][1]case __NR_memfd_create: {
[2][1]struct pending_open *po = bpf_map_lookup_elem(&edr_pending_open, &pid_tgid);
[2][1]if (!po) break;
[2][1]
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (e) {
[2][1]ev_fill_common(e, EVT_MEMFD_CREATE, id, tgid);
[2][1]e->ret = ret; e->fd = (ret >= 0) ? (__s32)ret : -1;
[2][1]__builtin_memcpy(e->path, po->path, sizeof(e->path));
[2][1]e->flags = po->flags;
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]}
[2][1]
[2][1]if (ret >= 0) {
[2][1]struct fd_key fk = { .tgid = tgid, .fd = (__s32)ret };
[2][1]struct fd_meta fm = {};
[2][1]fm.kind = 1; // treat as file-ish
[2][1]__builtin_memcpy(fm.path, po->path, sizeof(fm.path));
[2][1]bpf_map_update_elem(&edr_fd_table, &fk, &fm, BPF_ANY);
[2][1]}
[2][1]bpf_map_delete_elem(&edr_pending_open, &pid_tgid);
[2][1]break;
[2][1]}
[2][1]#endif
[2][1]
[2][1]/* accept → new fd + peer tuple */
[2][1]case __NR_accept:
[2][1]#if defined(__NR_accept4)
[2][1]case __NR_accept4:
[2][1]#endif
[2][1]{
[2][1]struct pending_accept *pa = bpf_map_lookup_elem(&edr_pending_accept, &pid_tgid);
[2][1]
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (e) {
[2][1]ev_fill_common(e, EVT_ACCEPT, id, tgid);
[2][1]e->ret = ret; e->fd = (ret >= 0) ? (__s32)ret : -1;
[2][1]if (pa) {
[2][1]e->fam = pa->fam; e->proto = IPPROTO_TCP; // heuristic
[2][1]e->rport  = pa->rport; e->raddr4 = pa->raddr4;
[2][1]__builtin_memcpy(e->raddr6, pa->raddr6, 16);
[2][1]}
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]}
[2][1]
[2][1]if (ret >= 0) {
[2][1]struct fd_key fk = { .tgid = tgid, .fd = (__s32)ret };
[2][1]struct fd_meta fm = {};
[2][1]fm.kind = 2; fm.family = pa ? pa->fam : 0; fm.proto = IPPROTO_TCP;
[2][1]fm.rport = pa ? pa->rport : 0; fm.raddr4 = pa ? pa->raddr4 : 0;
[2][1]if (pa) __builtin_memcpy(fm.raddr6, pa->raddr6, 16);
[2][1]bpf_map_update_elem(&edr_fd_table, &fk, &fm, BPF_ANY);
[2][1]}
[2][1]if (pa) bpf_map_delete_elem(&edr_pending_accept, &pid_tgid);
[2][1]break;
[2][1]}
[2][1]
[2][1]#if defined(__NR_dup) || defined(__NR_dup2) || defined(__NR_dup3)
[2][1]case __NR_dup:
[2][1]#  if defined(__NR_dup2)
[2][1]case __NR_dup2:
[2][1]#  endif
[2][1]#  if defined(__NR_dup3)
[2][1]case __NR_dup3:
[2][1]#  endif
[2][1]{
[2][1]if (ret >= 0) {
[2][1]__s32 *oldfdp = bpf_map_lookup_elem(&edr_pending_dup, &pid_tgid);
[2][1]__s32 oldfd = oldfdp ? *oldfdp : -1;
[2][1]__s32 newfd = (__s32)ret;
[2][1]
[2][1]if (oldfd >= 0) {
[2][1]struct fd_key src = { .tgid = tgid, .fd = oldfd };
[2][1]struct fd_key dst = { .tgid = tgid, .fd = newfd };
[2][1]struct fd_meta *fm = bpf_map_lookup_elem(&edr_fd_table, &src);
[2][1]if (fm) {
[2][1]bpf_map_update_elem(&edr_fd_table, &dst, fm, BPF_ANY);
[2][1]}
[2][1]}
[2][1]
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (e) {
[2][1]ev_fill_common(e, EVT_DUP, id, tgid);
[2][1]e->fd = newfd; e->aux_u32 = (unsigned)(oldfd >= 0 ? oldfd : 0);
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]}
[2][1]
[2][1]if (oldfdp) bpf_map_delete_elem(&edr_pending_dup, &pid_tgid);
[2][1]}
[2][1]break;
[2][1]}
[2][1]#endif
[2][1]
[2][1]case __NR_clone:
[2][1]#if defined(__NR_clone3)
[2][1]case __NR_clone3:
[2][1]#endif
[2][1]{
[2][1]struct pending_clone *pc = bpf_map_lookup_elem(&edr_pending_clone, &pid_tgid);
[2][1]struct edr_event *e = ev_reserve_zero();
[2][1]if (e) {
[2][1]ev_fill_common(e, EVT_CLONE, id, tgid);
[2][1]e->ret  = ret;  // child pid (>0) in parent
[2][1]if (pc) e->aux_u64 = pc->flags;
[2][1]bpf_ringbuf_submit(e, 0);
[2][1]}
[2][1]if (pc) bpf_map_delete_elem(&edr_pending_clone, &pid_tgid);
[2][1]break;
[2][1]}
[2][1]
[2][1]default:
[2][1]break;
[2][1]}
[2][1]
[2][1]return 0;
[2][1]}
