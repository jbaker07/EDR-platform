# Copy this file to .env and fill in real values. NEVER commit a real .env.
# (The real .env files were removed from tracking and rotated — see README.)

# Auth tokens for the SHAP explain and GNN trust endpoints.
SHAP_AUTH_TOKEN=changeme
GNN_AUTH_TOKEN=changeme

# Database connection string. Defaults to a local SQLite file if unset
# (sqlite:///./edr.db). Set to a Postgres URL for asyncpg in production, e.g.
# postgresql+asyncpg://user:password@localhost:5432/edr
DATABASE_URL=sqlite:///./edr.db

# Optional: extra import roots if running modules outside the backend/ CWD.
# PYTHONPATH=.

# Path to the PEM private key that signs update manifests, intel packs and
# agent logs. Keep the key outside the repo. To make one:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out ~/.edr/signing_key.pem
EDR_SIGNING_KEY_PATH=
