# Example environment file for the EDR platform.
#
# Copy this to `.env` and replace the placeholder values with real secrets.
# `.env` is gitignored and must NEVER be committed (the previous committed
# `.env` shipped dummy "super-secret-token" values — see .gitignore).

# Make the backend package importable.
PYTHONPATH=./backend

# Auth tokens guarding the SHAP / GNN explainer endpoints.
# Set strong, unique values per environment.
export SHAP_AUTH_TOKEN=replace-with-a-real-token
export GNN_AUTH_TOKEN=replace-with-a-real-token
