# Copy this file to .env and fill in real values. Never commit a real .env.

# Backend bearer token for every API route. 32 or more characters. Make one with:
#   openssl rand -hex 32
# The backend does not read this file. Export it or pass it through compose.
EDR_API_TOKEN=
# Agent API bearer token. 32 or more characters. Without it the agent opens no API port.
EDR_AGENT_TOKEN=
# Set to 1 only on a dev machine to run both APIs with no token.
# EDR_DEV_NO_AUTH=1
# Origin the browser may call the backend from.
# EDR_DASHBOARD_ORIGIN=http://localhost:5173
# Exact origins allowed to call the agent API, comma separated.
# EDR_AGENT_CORS_ORIGINS=

# Backend database. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./edr.db

# Prevention guard mode: off, monitor or enforce.
# EDR_GUARD_MODE=monitor

# Public key that verifies edr-agent/policy.json.sig. Defaults to
# edr-agent/config/policy_pub.pem. The private signing key stays outside the repo.
# EDR_POLICY_PUBKEY=
