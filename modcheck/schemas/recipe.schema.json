{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modcheck.dev/schemas/recipe.schema.json",
  "title": "Development recipe",
  "description": "An executable-to-a-creator procedure for accomplishing one modification.",
  "type": "object",
  "required": ["id", "game", "title", "intent", "applies_to", "extension_points",
               "steps", "validation", "acceptance", "references", "verification_state", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "game": {"$ref": "common.schema.json#/$defs/game_id"},
    "title": {"type": "string", "minLength": 5},
    "category": {
      "type": "string",
      "enum": ["add_content", "modify_data_record", "event_behavior", "extend_system",
               "content_pack", "optional_integration", "compatibility_patch", "asset_workflow", "tooling"]
    },
    "intent": {"type": "string", "minLength": 20, "description": "What the creator ends up with."},
    "applies_to": {
      "type": "object",
      "required": ["game_versions"],
      "additionalProperties": false,
      "properties": {
        "game_versions": {"$ref": "common.schema.json#/$defs/version_range"},
        "loader": {"type": "string"},
        "loader_versions": {"$ref": "common.schema.json#/$defs/version_range"},
        "toolchain": {"type": "array", "items": {"type": "string"}},
        "platforms": {"type": "array", "items": {"type": "string"}}
      }
    },
    "inputs": {"type": "array", "items": {"type": "string"}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["loader", "framework", "library", "tool", "content_mod", "runtime"]},
          "versions": {"$ref": "common.schema.json#/$defs/version_range"},
          "required": {"type": "boolean", "default": true}
        }
      }
    },
    "template": {
      "type": "object",
      "description": "The existing template or project pattern reused rather than written from scratch.",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string"},
        "license": {"type": "string"},
        "local_generator": {"type": "string", "description": "modcheck scaffold generator id, when we ship one."}
      }
    },
    "extension_points": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/target"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "detail"],
        "additionalProperties": false,
        "properties": {
          "step": {"type": "string"},
          "detail": {"type": "string", "minLength": 10},
          "file": {"type": "string"},
          "code": {"type": "string"},
          "command": {"type": "string"}
        }
      }
    },
    "interactions": {
      "type": "array",
      "description": "Known interactions and assumptions this approach carries.",
      "items": {"type": "string"}
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {"type": "array", "items": {"type": "string"}},
        "produces": {"type": "string"},
        "requires_network": {"type": "boolean"},
        "requires_game_install": {"type": "boolean"}
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "limits"],
        "additionalProperties": false,
        "properties": {
          "method": {"type": "string"},
          "command": {"type": "string"},
          "modcheck_check": {"type": "string", "description": "Check id implemented in this repo."},
          "limits": {"type": "string", "minLength": 10, "description": "What this check does NOT establish."}
        }
      }
    },
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "references": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}},
    "verification_state": {"$ref": "common.schema.json#/$defs/verification_state"},
    "verification_note": {"type": "string"},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"}
  }
}
