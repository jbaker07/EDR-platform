{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modcheck.dev/schemas/source.schema.json",
  "title": "Source record",
  "description": "One retrieved upstream artifact. Nothing may be cited that has no source record.",
  "type": "object",
  "required": [
    "id",
    "title",
    "url",
    "kind",
    "access",
    "retrieved_at",
    "reuse"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "publisher": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "official_docs",
        "community_wiki",
        "source_repo",
        "api",
        "schema",
        "release_artifact",
        "issue_tracker",
        "analyzer_output",
        "forum_post",
        "spec"
      ]
    },
    "games": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/game_id"
      }
    },
    "access": {
      "type": "string",
      "description": "blocked/deleted/discord_only are gaps, not acquired knowledge.",
      "enum": [
        "public",
        "api_key_required",
        "rate_limited",
        "blocked",
        "deleted",
        "discord_only",
        "paywalled"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "http_status": {
      "type": "integer"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "content_type": {
      "type": "string"
    },
    "evidence_path": {
      "type": "string",
      "description": "Path in evidence_cache/ (gitignored; re-fetchable from url+sha256)."
    },
    "upstream_revision": {
      "type": "string",
      "description": "Commit sha, page revision id, tag, or Last-Modified."
    },
    "license": {
      "type": "string",
      "description": "SPDX id where known, else 'unknown' or a free-text term."
    },
    "reuse": {
      "type": "object",
      "description": "Public availability never implies redistribution, commercial reuse, or training rights.",
      "required": [
        "redistribute",
        "commercial",
        "derive"
      ],
      "additionalProperties": false,
      "properties": {
        "redistribute": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "attribution_required",
            "share_alike",
            "unknown"
          ]
        },
        "commercial": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "derive": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "share_alike",
            "unknown"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "gap": {
      "type": "string",
      "description": "Set when access is blocked/deleted/discord_only: what we therefore do not know."
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Hash of the meaningful content with volatile per-request markup removed. Drift that moves only `sha256` is volatility, not an upstream change."
    }
  }
}
