{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modcheck.dev/schemas/failure.schema.json",
  "title": "Documented failure case",
  "description": "A real, sourced failure mode with its established cause. Not a hypothetical.",
  "type": "object",
  "required": ["id", "game", "title", "symptom", "mechanism", "evidence", "detector", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "game": {"$ref": "common.schema.json#/$defs/game_id"},
    "title": {"type": "string", "minLength": 5},
    "symptom": {"type": "string", "minLength": 15, "description": "What the player or creator actually observes."},
    "mechanism": {"type": "string", "minLength": 20, "description": "The established cause, not a guess."},
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "game_versions": {"$ref": "common.schema.json#/$defs/version_range"},
        "loader": {"type": "string"},
        "loader_versions": {"$ref": "common.schema.json#/$defs/version_range"},
        "toolchain": {"type": "array", "items": {"type": "string"}}
      }
    },
    "targets": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/target"}},
    "conditions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/condition"}},
    "detector": {
      "type": "object",
      "required": ["detectable"],
      "additionalProperties": false,
      "properties": {
        "detectable": {"type": "string", "enum": ["yes", "partial", "no"]},
        "check_id": {"type": "string", "description": "Check implemented in this repo that finds it."},
        "signal": {"type": "string", "description": "What the check keys on."},
        "why_not": {"type": "string"}
      }
    },
    "resolutions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"}
  }
}
