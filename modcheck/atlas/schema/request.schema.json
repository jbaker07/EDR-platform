{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modcheck/atlas/request",
  "title": "Request-specific engineering analysis",
  "type": "object",
  "required": [
    "id",
    "title",
    "family",
    "request",
    "approved_behaviour",
    "preserve",
    "affected_systems",
    "candidates",
    "dependencies",
    "interactions",
    "alternatives",
    "work",
    "verification",
    "unresolved",
    "evidence",
    "status",
    "provenance",
    "canonical_request",
    "analyst_exercise"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^request\\.[a-z0-9_]+$"
    },
    "title": {
      "type": "string"
    },
    "family": {
      "type": "string",
      "pattern": "^workflow:"
    },
    "request": {
      "type": "string",
      "minLength": 40,
      "description": "The creator's words, or a faithful paraphrase marked as such"
    },
    "approved_behaviour": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "preserve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "affected_systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 30
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^question:"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "object",
      "required": [
        "analysed",
        "implemented",
        "validated_scope"
      ],
      "properties": {
        "analysed": {
          "type": "boolean"
        },
        "implemented": {
          "type": "string"
        },
        "validated_scope": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "author",
        "added"
      ],
      "properties": {
        "author": {
          "const": "analyst"
        },
        "added": {
          "type": "string"
        }
      }
    },
    "canonical_request": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "the request record id this analysis is bound to"
        },
        "kind": {
          "type": "string",
          "enum": [
            "creator_request",
            "analyst_exercise"
          ]
        },
        "path": {
          "type": "string",
          "description": "repository path of the canonical record (creator requests)"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "hash of that file when the analysis was written; the validator re-checks it"
        },
        "revision_of": {
          "type": "string"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "analyst_exercise": {
      "type": "boolean",
      "description": "true when no creator wrote this request; the analyst did, to exercise the atlas"
    },
    "proposed_contract": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "decisions the implementer proposed that the request leaves open; not creator intent"
    },
    "analyst_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "assumptions this analysis makes beyond the request and its proposed contract"
    }
  }
}
