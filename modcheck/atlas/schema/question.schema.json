{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modcheck.dev/schemas/atlas/question.schema.json",
  "title": "Atlas unresolved question",
  "description": "A gap that can be closed. Every field is required because a question missing any of them is 'figure this out', which is not an engineering task.",
  "type": "object",
  "required": ["id", "question", "kind", "affects", "why_it_matters", "evidence_available", "best_remaining_source", "procedure", "completion_condition", "conclusions_affected_while_open", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "question": {"type": "string", "minLength": 20},
    "kind": {
      "description": "Different problems need different responses; this says which.",
      "enum": ["missing_documentation", "missing_artifact_access", "incomplete_extraction", "ambiguous_creator_intent", "unmodeled_behaviour", "conflicting_requirements", "unimplemented_automation", "unavailable_runtime_observation"]
    },
    "affects": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "workflow ids, request ids, system ids or edge ids"},
    "why_it_matters": {"type": "string", "minLength": 20},
    "evidence_available": {"type": "array", "items": {"type": "string"}},
    "best_remaining_source": {"type": "string", "minLength": 5},
    "procedure": {"type": "string", "minLength": 20},
    "completion_condition": {"type": "string", "minLength": 15},
    "conclusions_affected_while_open": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["open", "in_progress", "resolved", "wont_resolve"]},
    "resolved_by": {"type": "string"},
    "provenance": {"type": "object", "properties": {"added": {"type": "string"}, "author": {"enum": ["analyst", "extractor"]}}}
  }
}
