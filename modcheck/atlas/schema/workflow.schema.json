{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modcheck.dev/schemas/atlas/workflow.schema.json",
  "title": "Atlas workflow family",
  "description": "One thing creators set out to do, traced from intent to what ModCheck should contribute. Authored, and every 'today' claim names the evidence it rests on.",
  "type": "object",
  "required": ["id", "area", "title", "intent", "preserve", "tools_today", "decisions", "information_needed", "automation_existing", "remaining_manual", "modcheck_contribution", "evidence", "status", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "area": {"enum": ["content", "world", "behaviour", "presentation", "state", "multiplayer", "integration", "engineering"]},
    "title": {"type": "string"},
    "intent": {"type": "string", "description": "What the creator wants, in outcome terms -- not a mechanism."},
    "preserve": {"type": "array", "items": {"type": "string"}, "description": "What must remain unchanged for the outcome to count."},
    "mechanisms": {"type": "array", "items": {"type": "string"}, "description": "atlas mechanism ids that can serve this family; data-driven ones listed before code ones where both exist"},
    "tools_today": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "information_needed": {"type": "array", "items": {"type": "string"}},
    "automation_existing": {"type": "array", "items": {"type": "string"}},
    "remaining_manual": {"type": "array", "items": {"type": "string"}},
    "modcheck_contribution": {"type": "array", "items": {"type": "string"}},
    "interactions_to_check": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "source ids, extracted-file ids, or record ids"},
    "questions": {"type": "array", "items": {"type": "string"}},
    "status": {
      "type": "object",
      "required": ["inventoried", "mechanically_inspected", "contract_mapped", "interaction_analysed", "implemented_in_modcheck", "validated_scope"],
      "properties": {
        "inventoried": {"type": "boolean"},
        "mechanically_inspected": {"type": "boolean"},
        "contract_mapped": {"type": "boolean"},
        "interaction_analysed": {"type": "boolean"},
        "implemented_in_modcheck": {"type": "boolean"},
        "validated_scope": {"type": "string"}
      }
    },
    "provenance": {"type": "object", "required": ["author", "added"], "properties": {"author": {"enum": ["analyst"]}, "added": {"type": "string"}, "reviewed": {"type": "boolean"}}}
  }
}
