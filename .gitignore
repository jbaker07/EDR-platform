# ── OS / editor ─────────────────────────────────────────────
.DS_Store
.vscode/
*.swp

# ── Secrets ─────────────────────────────────────────────────
# Never commit real env files; commit *.env.example templates instead.
.env
*.env
!*.env.example
!.env.example

# ── Node ────────────────────────────────────────────────────
node_modules/
dist/
build/

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/

# ── Rust / native build ─────────────────────────────────────
target/
target_user/
**/target/
**/target_user/

# ── eBPF build artifacts ────────────────────────────────────
_bpf_build/
*.bpf.o
*.module-common.o

# ── ML model binaries (regenerated by training) ─────────────
*.joblib
*.pkl
*.pt
*.pth

# ── Vendored binaries ───────────────────────────────────────
splunkd

# ── Logs, fixtures & captures ───────────────────────────────
# NOTE: this is intentionally NOT a bare `logs/` rule — a bare
# `logs/` would swallow the source package backend/app/logs/.
/logs/
/backend/logs/
*.log

# Runtime-written dirs created from CWD-relative paths in the app/services.
# (Several modules build paths like "backend/..." relative to the process CWD;
# when launched from backend/ that materialises a stray backend/backend/ tree.)
/backend/backend/
dev/fixtures/*.pcap
dev/fixtures/*.pcapng
dev/fixtures/*.gz
dev/fixtures/*.zip
dev/fixtures/*.jsonl
dev/fixtures/*.ndjson
telemetry_output/
**/*.jsonl
**/*.ndjson

# ── Generated runtime log JSON (but keep the source package) ─
backend/app/logs/*.json

# ── Docker / OpenSearch data ────────────────────────────────
**/data/
**/opensearch-data/
