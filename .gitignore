logs/
*.log
dev/fixtures/*.pcap
dev/fixtures/*.pcapng
dev/fixtures/*.gz
dev/fixtures/*.zip
dev/fixtures/*.jsonl
dev/fixtures/*.ndjson
telemetry_output/
