  "escalation_rules": [
    {
      "trigger": "process_spawn_anomaly",
      "threshold": "num_children > 10",
      "action": "switch_to_forensic"
    },
    {
      "trigger": "external_comm_attempt",
      "context": "unsigned_process + beaconed",
      "action": "switch_to_forensic"
    },
    {
      "trigger": "geo_anomaly",
      "context": "new_device + remote_access_tool",
      "action": "switch_to_forensic"
    },
    {
      "trigger": "file_entropy",
      "threshold": "entropy > 0.95",
      "action": "switch_to_forensic"
    },
    {
      "trigger": "macro_exec",
      "context": "office_macro + powershell + IEX",
      "action": "switch_to_forensic"
    },
    {
      "trigger": "usb_exfil",
      "context": "usb_mount + file_entropy > 0.9 + off_hours",
      "action": "switch_to_forensic"
    },
    {
      "trigger": "cloud_token_misuse",
      "context": "access_key + geo_anomaly",
      "action": "switch_to_forensic"
    },
    {
      "trigger": "script_chain",
